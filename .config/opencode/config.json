{
  "$schema": "https://opencode.ai/config.json",
  "theme": "opencode",
  "keybinds": {
    "input_newline": "shift+enter,ctrl+j"
  },
  "experimental": {
    "OPENCODE_EXPERIMENTAL_ICON_DISCOVERY": true,
    "OPENCODE_EXPERIMENTAL_EXA": true,
    "OPENCODE_EXPERIMENTAL_MARKDOWN": true,
    "OPENCODE_EXPERIMENTAL_PLAN_MODE": true,
    "disable_paste_summary": true
  },
  "tui": {
    "scroll_acceleration": {
      "enabled": true
    }
  },
  "permission": {
    "external_directory": {
      "~/.opensrc/**": "allow",
      "/tmp/**": "allow"
    }
  },
  "provider": {
    "openrouter": {
      "npm": "@openrouter/ai-sdk-provider",
      "name": "OpenRouter",
      "env": ["OPENROUTER_API_KEY"],
      "options": {},
      "models": {
        "anthropic/claude-3.5-sonnet": {
          "name": "Claude 3.5 Sonnet"
        },
        "anthropic/claude-sonnet-4": {
          "name": "Claude 4 Sonnet"
        }
      }
    },
    "bethelAIGateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Bethel AI Gateway",
      "options": {
        "baseURL": "{env:BETHEL_AI_GATEWAY_BASE_URL}",
        "apiKey": "{env:BETHEL_AI_GATEWAY_API_TOKEN}"
      },
      "models": {
        "bedrock/us.anthropic.claude-opus-4-5-20251101-v1:0": {
          "name": "Claude Opus 4.5",
          "cost": {
            "input": 15,
            "output": 75,
            "cache_read": 1.5,
            "cache_write": 18.75
          },
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "bedrock/us.anthropic.claude-sonnet-4-5-20250929-v1:0": {
          "name": "Claude Sonnet 4.5",
          "cost": {
            "input": 3,
            "output": 15,
            "cache_read": 0.3,
            "cache_write": 3.75
          },
          "limit": {
            "context": 200000,
            "output": 64000
          }
        },
        "bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0": {
          "name": "Claude Haiku 4.5",
          "cost": {
            "input": 0.8,
            "output": 4,
            "cache_read": 0.08,
            "cache_write": 1
          },
          "limit": {
            "context": 200000,
            "output": 64000
          }
        },
        "azure/gpt-5.2": {
          "name": "GPT-5.2",
          "reasoning": false,
          "options": {
            "reasoningSummary": null
          },
          "cost": {
            "input": 2.5,
            "output": 10
          },
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "azure/gpt-5": {
          "name": "GPT-5",
          "reasoning": false,
          "options": {
            "reasoningSummary": null
          },
          "cost": {
            "input": 2.5,
            "output": 10
          },
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "azure/gpt-5-mini": {
          "name": "GPT-5 Mini",
          "reasoning": false,
          "options": {
            "reasoningSummary": null
          },
          "cost": {
            "input": 0.15,
            "output": 0.6
          },
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gemini/gemini-3-pro-preview": {
          "name": "Gemini 3 Pro Preview",
          "cost": {
            "input": 1.25,
            "output": 5
          },
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        }
      }
    }
  },
  "mcp": {
    "linear": {
      "type": "local",
      "enabled": false,
      "command": ["npx", "-y", "mcp-remote", "https://mcp.linear.app/mcp"]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    }
  }
}

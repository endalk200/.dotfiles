{
  "theme": {
    "name": "tokyonight",
    "mode": "system"
  },
  "keybinds": {
    "input.newline": "shift+return,ctrl+j"
  },
  "scroll": {
    "acceleration": true
  },
  "diffs": {
    "wrap": "word",
    "view": "unified",
    "single": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "grouping": "auto",
    "image_preview": true
  },
  "hints": {
    "onboarding": false
  },
  "animations": true,
  "prompt": {
    "image_preview": false
  }
}

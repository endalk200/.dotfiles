{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/.opensrc/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    }
  ],
  "providers": {
    "cliproxy-claude": {
      "name": "Agent Gateway (Claude)",
      "canonical": "anthropic",
      "package": "@opencode/ai/providers/anthropic",
      "settings": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "{file:~/.local/share/agent-gateway/client-key}"
      },
      "models": {
        "claude-fable-5-1": { "name": "Claude Fable 5.1" },
        "claude-opus-5-5": { "name": "Claude Opus 5.5" },
        "claude-sonnet-5-5": { "name": "Claude Sonnet 5.5" },
        "claude-haiku-5-5": { "name": "Claude Haiku 5.5" }
      }
    },
    "cliproxy-codex": {
      "name": "Agent Gateway (Codex)",
      "canonical": "openai",
      "package": "@opencode/ai/providers/openai/responses",
      "settings": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "{file:~/.local/share/agent-gateway/client-key}"
      },
      "models": {
        "gpt-6-astra": { "name": "GPT-6 Astra" },
        "gpt-6.1-sol": { "name": "GPT-6.1 Sol" },
        "gpt-6.1-terra": { "name": "GPT-6.1 Terra" },
        "gpt-6-luna": { "name": "GPT-6 Luna" }
      }
    },
    "openrouter": {
      "package": "aisdk:@openrouter/ai-sdk-provider",
      "name": "OpenRouter",
      "env": [
        "OPENROUTER_API_KEY"
      ],
      "models": {
        "anthropic/claude-3.5-sonnet": {
          "name": "Claude 3.5 Sonnet"
        },
        "anthropic/claude-sonnet-4": {
          "name": "Claude 4 Sonnet"
        }
      }
    },
    "bethelAIGateway": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Bethel AI Gateway",
      "settings": {
        "baseURL": "https://aigw.bethelservice.org",
        "apiKey": "{env:BETHEL_AI_GATEWAY_API_TOKEN}"
      },
      "models": {
        "bedrock/global.anthropic.claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6",
          "cost": {
            "input": 3,
            "output": 15
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 64000
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            }
          ]
        },
        "bedrock/global.anthropic.claude-opus-4-6-v1": {
          "name": "Claude Opus 4.6",
          "cost": {
            "input": 5,
            "output": 25
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            }
          ]
        },
        "bedrock/us.anthropic.claude-opus-4-5-20251101-v1:0": {
          "name": "Claude Opus 4.5",
          "cost": {
            "input": 15,
            "output": 75,
            "cache": {
              "read": 1.5,
              "write": 18.75
            }
          },
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "bedrock/us.anthropic.claude-sonnet-4-5-20250929-v1:0": {
          "name": "Claude Sonnet 4.5",
          "cost": {
            "input": 3,
            "output": 15,
            "cache": {
              "read": 0.3,
              "write": 3.75
            }
          },
          "limit": {
            "context": 200000,
            "output": 64000
          }
        },
        "azure/gpt-5.2": {
          "name": "GPT-5.2",
          "cost": {
            "input": 1.75,
            "output": 14
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            }
          ]
        },
        "gemini/gemini-3-pro-preview": {
          "name": "Gemini 3 Pro Preview",
          "cost": {
            "input": 1.25,
            "output": 5
          },
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "linear": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "mcp-remote",
          "https://mcp.linear.app/mcp"
        ],
        "disabled": true
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": true
      }
    },
    "posthog": {
      "type": "remote",
      "url": "https://mcp.posthog.com/mcp"
    }
  },
  "model": "bethelAIGateway/azure/gpt-5.2",
  "websearch": {
    "provider": "random"
  }
}

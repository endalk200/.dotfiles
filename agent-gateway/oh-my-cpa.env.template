# Oh My CPA environment. `agent-gateway install-omc` renders this file into
# ~/.local/share/oh-my-cpa/.env with the generated keys.
OMCPA_LISTEN_ADDR=127.0.0.1:8080
OMCPA_BASE_PATH=/
OMCPA_DATA_DIR=./data
# Encrypts the database. Never change it once data exists.
OMCPA_MASTER_KEY=__OMC_MASTER_KEY__
OMCPA_CPA_BASE_URL=http://127.0.0.1:8317
# CPA's plaintext management key, also the console sign-in password.
OMCPA_CPA_MANAGEMENT_KEY=__MANAGEMENT_KEY__
TZ=Africa/Addis_Ababa
# Oh My CPA is the only usage reader for this CPA.
OMCPA_USAGE_INGEST_MODE=auto
